# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Browser-safe (Publishable key or legacy anon JWT)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Server-only secret (Legacy service_role) — never commit real value
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Admin ──
ADMIN_EMAILS=you@example.com

# ── App URLs ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TRACKING_BASE_URL=https://2xgen.com

# Google OAuth: Supabase → Authentication → URL Configuration
# Site URL: https://2xgen.com
# Redirect URLs (add all of these):
#   http://localhost:3000/auth/callback
#   https://2xgen.com/auth/callback
#   http://localhost:3000/**
#   https://2xgen.com/**

# ── Stripe ──
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_ANNUAL=price_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Optional Resend ──
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=2xGen <noreply@2xgen.com>
# Ops alerts for new accounts + paid orders (defaults to matthijs@2xgen.com)
ADMIN_NOTIFY_EMAIL=matthijs@2xgen.com

# ── SEO ──
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
